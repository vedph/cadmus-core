-- --------------------------------------------------------------------------
-- Cadmus items index - PostgreSQL schema
-- --------------------------------------------------------------------------
-- This script is idempotent: it creates the schema in a new database, and
-- brings the schema of an existing database up to date, upgrading databases
-- created by versions up to 16 (bpchar IDs, int4 pin IDs, indexes not suited
-- to the queries). Running it on an up-to-date database changes nothing.
--
-- Queries supported by the indexes:
-- - item search: item fields (title/description via trigrams, facet, group),
--   sorted and paged by sort key; pin clauses are EXISTS subqueries on pin,
--   matched by name + value (btree), or by value via trigrams for contains,
--   ends-with, regex and similarity.
-- - pin search: name + value prefix (lookup), part type, item.
-- - writes: each save deletes the pins of a part (part_id) and inserts the
--   new ones; deleting an item cascades on pin (item_id).
-- --------------------------------------------------------------------------

-- trigram matching for LIKE/ILIKE, regular expressions and similarity
CREATE EXTENSION IF NOT EXISTS pg_trgm;

-- item: the essential metadata of each item
CREATE TABLE IF NOT EXISTS item (
	id varchar(36) NOT NULL,
	title varchar(500) NOT NULL,
	description varchar(1000) NOT NULL,
	facet_id varchar(100) NOT NULL,
	group_id varchar(100) NULL,
	sort_key varchar(1000) NOT NULL,
	flags int4 NOT NULL,
	time_created timestamptz NOT NULL,
	creator_id varchar(100) NULL,
	time_modified timestamptz NOT NULL,
	user_id varchar(100) NULL,
	CONSTRAINT item_pk PRIMARY KEY (id)
);

-- pin: the data pins emitted by each part
CREATE TABLE IF NOT EXISTS pin (
	id int8 GENERATED BY DEFAULT AS IDENTITY NOT NULL,
	item_id varchar(36) NOT NULL,
	part_id varchar(36) NOT NULL,
	part_type_id varchar(100) NOT NULL,
	part_role_id varchar(100) NULL,
	"name" varchar(100) NOT NULL,
	value varchar(500) NOT NULL,
	time_indexed timestamptz NOT NULL,
	CONSTRAINT pin_pk PRIMARY KEY (id),
	CONSTRAINT pin_fk FOREIGN KEY (item_id) REFERENCES item(id)
		ON DELETE CASCADE ON UPDATE CASCADE
);

-- legacy indexes (up to v16), replaced by those below; dropped before any
-- column upgrade so that they are not rebuilt in vain
DROP INDEX IF EXISTS item_flags_idx;
DROP INDEX IF EXISTS item_title_idx;
DROP INDEX IF EXISTS item_sort_key_idx;
DROP INDEX IF EXISTS pin_name_idx;
DROP INDEX IF EXISTS pin_value_idx;
DROP INDEX IF EXISTS pin_part_role_id_idx;

-- upgrade legacy columns (up to v16)
DO $$
DECLARE
	seq text;
BEGIN
	-- bpchar(36) IDs: comparing them with text parameters prevented the
	-- use of their indexes
	IF EXISTS (SELECT 1 FROM information_schema.columns
		WHERE table_schema = current_schema() AND table_name = 'item'
		AND column_name = 'id' AND data_type = 'character') THEN
		ALTER TABLE pin DROP CONSTRAINT IF EXISTS pin_fk;
		ALTER TABLE item ALTER COLUMN id TYPE varchar(36) USING rtrim(id);
		ALTER TABLE pin
			ALTER COLUMN item_id TYPE varchar(36) USING rtrim(item_id),
			ALTER COLUMN part_id TYPE varchar(36) USING rtrim(part_id);
		ALTER TABLE pin ADD CONSTRAINT pin_fk FOREIGN KEY (item_id)
			REFERENCES item(id) ON DELETE CASCADE ON UPDATE CASCADE;
	END IF;

	-- int4 pin IDs: pins are deleted and reinserted at each save, so their
	-- IDs grow continuously
	IF EXISTS (SELECT 1 FROM information_schema.columns
		WHERE table_schema = current_schema() AND table_name = 'pin'
		AND column_name = 'id' AND data_type = 'integer') THEN
		ALTER TABLE pin ALTER COLUMN id TYPE int8;
		seq := pg_get_serial_sequence('pin', 'id');
		IF seq IS NOT NULL THEN
			EXECUTE format('ALTER SEQUENCE %s AS int8', seq);
		END IF;
	END IF;

	-- nullable sort key
	IF EXISTS (SELECT 1 FROM information_schema.columns
		WHERE table_schema = current_schema() AND table_name = 'item'
		AND column_name = 'sort_key' AND is_nullable = 'YES') THEN
		UPDATE item SET sort_key = '' WHERE sort_key IS NULL;
		ALTER TABLE item ALTER COLUMN sort_key SET NOT NULL;
	END IF;
END $$;

-- item indexes
-- sorting and paging of search results
CREATE INDEX IF NOT EXISTS item_sort_key_id_idx ON item
	USING btree (sort_key, id);
CREATE INDEX IF NOT EXISTS item_facet_id_idx ON item USING btree (facet_id);
CREATE INDEX IF NOT EXISTS item_group_id_idx ON item USING btree (group_id);
-- equality, LIKE (any position), regular expressions and similarity
CREATE INDEX IF NOT EXISTS item_title_trgm_idx ON item
	USING gin (title gin_trgm_ops);
CREATE INDEX IF NOT EXISTS item_description_trgm_idx ON item
	USING gin (description gin_trgm_ops);

-- pin indexes
-- foreign key: EXISTS subqueries from item, cascade deletes
CREATE INDEX IF NOT EXISTS pin_item_id_idx ON pin USING btree (item_id);
-- replacing the pins of a part at each save
CREATE INDEX IF NOT EXISTS pin_part_id_idx ON pin USING btree (part_id);
-- name with value equality or prefix (pattern ops support LIKE 'x%')
CREATE INDEX IF NOT EXISTS pin_name_value_idx ON pin
	USING btree ("name", value text_pattern_ops);
-- value contains, ends-with, regular expressions and similarity
CREATE INDEX IF NOT EXISTS pin_value_trgm_idx ON pin
	USING gin (value gin_trgm_ops);
-- part type (e.g. lookups, items with parts of a given type)
CREATE INDEX IF NOT EXISTS pin_part_type_id_idx ON pin
	USING btree (part_type_id);
